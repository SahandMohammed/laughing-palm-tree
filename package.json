{
  "name": "logicbloom-motion-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts LogicBloomLaunch out/logicbloom-launch.mp4 --codec=h264",
    "render:preview": "remotion render src/index.ts LogicBloomLaunch out/logicbloom-preview.mp4 --codec=h264 --scale=0.5",
    "typecheck": "tsc --noEmit",
    "hf:doctor": "npx hyperframes doctor",
    "hf:preview": "cd hyperframes/prive-liquid-launch && npx hyperframes preview",
    "hf:lint": "cd hyperframes/prive-liquid-launch && npx hyperframes lint",
    "hf:check": "cd hyperframes/prive-liquid-launch && npx hyperframes check",
    "hf:render": "cd hyperframes/prive-liquid-launch && npx hyperframes render -o renders/prive-liquid-glass-launch.mp4",
    "hf:v2:preview": "cd hyperframes/prive-launch-v2 && npx hyperframes preview",
    "hf:v2:lint": "cd hyperframes/prive-launch-v2 && npx hyperframes lint",
    "hf:v2:check": "cd hyperframes/prive-launch-v2 && npx hyperframes check",
    "hf:v2:render": "cd hyperframes/prive-launch-v2 && npx hyperframes render -o renders/prive-launch-v2.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "onnxruntime-node": "^1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "hyperframes": "0.8.114",
    "typescript": "^5.9.0"
  }
}