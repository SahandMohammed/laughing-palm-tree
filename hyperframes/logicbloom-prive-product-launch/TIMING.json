  "duration": 47.432,
  "sentences": [
    {"id":"vo01","start":0.000,"end":2.704,"text":"A great experience shouldn't end at the door."},
    {"id":"vo02","start":2.704,"end":8.287,"text":"For Privé, we set out to build a digital experience around the same idea that defines the lounge:"},
    {"id":"vo03","start":8.287,"end":10.110,"text":"being in the right hands."},
    {"id":"vo04","start":10.110,"end":12.521,"text":"We started with a new digital presence."},
    {"id":"vo05","start":12.521,"end":14.931,"text":"A website built around the Privé identity."},
    {"id":"vo06","start":14.931,"end":17.635,"text":"A unique digital invitation experience for the opening."},
    {"id":"vo07","start":17.635,"end":20.339,"text":"And the technology and infrastructure behind the business."},
    {"id":"vo08","start":20.339,"end":22.266,"text":"Then, we built something deeper."},
    {"id":"vo09","start":22.266,"end":29.076,"text":"A management system designed around the way Privé actually works — connecting operations, services, customers, and the team in one experience."},
    {"id":"vo10","start":29.076,"end":30.607,"text":"And we're still building."},
    {"id":"vo11","start":30.607,"end":38.591,"text":"A new mobile experience is coming next — making it easier to discover services, choose your master, book your time, and stay connected with Privé."},
    {"id":"vo12","start":38.591,"end":41.588,"text":"From the first interaction to every visit that follows."},
    {"id":"vo13","start":41.588,"end":43.412,"text":"Designed and built by LogicBloom."},
    {"id":"vo14","start":43.412,"end":45.632,"text":"Digital experiences, built around the business."}
  ],
